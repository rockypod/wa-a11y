# Runs only the checks the pushed changes can affect. WA_A11Y_FULL_CHECK=1 runs everything.
set -uo pipefail
ROOT="$(git rev-parse --show-toplevel)"
ZERO="$(printf '0%.0s' {1..40})"  # git's "no such ref" marker
run() {
  echo "pre-push: ${*:-all checks}"
  [[ "${WA_A11Y_HOOK_DRYRUN:-0}" == 1 ]] && exit 0
  exec "$ROOT/scripts/check" "$@"
}
[[ "${WA_A11Y_FULL_CHECK:-0}" == 1 ]] && run

files=""
while read -r _ local_sha _ remote_sha; do
  [[ "$local_sha" == "$ZERO" ]] && continue
  if [[ "$remote_sha" == "$ZERO" ]] || ! git cat-file -e "$remote_sha" 2>/dev/null; then
    base="$(git merge-base "$local_sha" "@{upstream}" 2>/dev/null)" || run
  else
    base="$remote_sha"
  fi
  [[ "$base" == "$local_sha" ]] && continue
  files+="$(git diff --name-only "$base" "$local_sha")"$'\n'
done
files="$(printf '%s' "$files" | sort -u | sed '/^$/d')"
[[ -z "$files" ]] && { echo "pre-push: nothing new to check"; exit 0; }

checks=(license-headers manifests pii-scan verify-export ignore-guard ignore-sync gitleaks)
add() { local c; for c in "$@"; do [[ " ${checks[*]} " == *" $c "* ]] || checks+=("$c"); done; }
while read -r f; do
  case "$f" in
    *.md|docs/*|LICENSE|NOTICE|.gitignore|.dockerignore|.gitattributes) ;;
    scripts/check|scripts/selfscan|scripts/sr-check|.githooks/*) run ;;
    web/app/routes.py|web/app/ui.py|web/app/main.py|web/app/icons.py|web/app/statement.py|\
    web/app/assessment/pages.py|web/app/security.py|web/app/theme.py|web/app/settings.py)
      add ruff pytest styles css-gates selfscan aria ;;
    web/uv.lock|web/pyproject.toml) add ruff pytest pip-audit ;;
    web/*|scripts/*|selfscan/*) add ruff pytest ;;
    styles/*) add styles css-gates selfscan aria ;;
    scanner/selfscan/*) add scanner-test typecheck fallow selfscan aria ;;
    scanner/*) add scanner-test typecheck fallow ;;
    pnpm-lock.yaml|package.json|*/package.json) add pnpm-audit scanner-test styles ;;
    *) ;;
  esac
done <<< "$files"
echo "pre-push: $(wc -l <<< "$files") changed file(s)"
run "${checks[@]}"
