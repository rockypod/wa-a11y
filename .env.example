# Copy to .env (git-ignored). The defaults work as they are. Never commit .env.

# Session signing key. Leave empty: a strong one is generated on first start and kept on the
# data volume. To set your own, use 32+ random characters (e.g. openssl rand -hex 32).
WA_A11Y_SESSION_SECRET=

# Published address: 127.0.0.1 (default) or a private IP behind a reverse proxy
WA_A11Y_BIND=127.0.0.1
WA_A11Y_PORT=8580
# Path prefix the outer proxy strips, e.g. /wa-a11y (default: empty, served at the root)
WA_A11Y_BASE_PATH=


# Seconds to wait for a result, 0–120 (0 = never, default 60); every proxy in front must allow longer
# WA_A11Y_WAIT_S=60
# Requests waiting at once, 1–64 (default 8)
# WA_A11Y_MAX_WAITERS=8
# Waiting slots per account (default 2)
# WA_A11Y_MAX_WAITERS_PER_USER=2

# Allow http:// targets (default: https only, any public website)
# WA_A11Y_ALLOW_HTTP=1
# Restrict targets to these domains
# WA_A11Y_ALLOWED_DOMAINS=example.org,example.net

# Security: allow loopback/LAN targets. Local installs only; keep off on shared servers
# WA_A11Y_ALLOW_LOCAL_TARGETS=1

# Accounts (admin-created, no self-registration):
#   docker compose exec web /app/.venv/bin/python -m app.accounts create you@example.com --admin

# AGPLv3 §7(c): footer shows "Based on wa-a11y, modified by …" (leave unset for the original)
# WA_A11Y_MODIFIED_BY=Example Organization

# Most checks waiting in the queue at once (default 20)
# WA_A11Y_MAX_QUEUED=20
# Time limit in seconds for one check (default 300)
# WA_A11Y_SCAN_TIMEOUT_S=300
