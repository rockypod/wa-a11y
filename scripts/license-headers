#!/usr/bin/env bash
# wa-a11y
# SPDX-License-Identifier: AGPL-3.0-or-later
#
# This file is part of wa-a11y.
# Copyright (C) 2026 Kevin Miller (rockypod)
# Modifications must retain this wa-a11y notice and document all changes
# pursuant to AGPLv3 Section 5 and Section 7.
set -uo pipefail
ROOT="$(git -C "$(dirname "$0")" rev-parse --show-toplevel 2>/dev/null)" || exit 2
cd "$ROOT" || exit 2
FIX=0; [[ "${1:-}" == "--fix" ]] && FIX=1
MARK="SPDX-License-Identifier: AGPL-3.0-or-later"

LINES=(
  "wa-a11y"
  "SPDX-License-Identifier: AGPL-3.0-or-later"
  ""
  "This file is part of wa-a11y."
  "Copyright (C) 2026 Kevin Miller (rockypod)"
  "Modifications must retain this wa-a11y notice and document all changes"
  "pursuant to AGPLv3 Section 5 and Section 7."
)

style() {
  case "$1" in
    *.py|*.sh|*.yaml|*.yml|*/Dockerfile|Dockerfile|*/Caddyfile|*.toml|*.ini|*.mako) echo hash ;;
    *.ts|*.mjs|*.js|*.scss|*.css) echo block ;;
    scripts/*|.memory/*) head -c 2 "$1" 2>/dev/null | grep -q '#!' && echo hash || echo none ;;
    *) echo none ;;
  esac
}

header() {
  local l
  if [[ "$1" == hash ]]; then
    for l in "${LINES[@]}"; do [[ -n "$l" ]] && echo "# $l" || echo "#"; done
  else
    echo "/*"; for l in "${LINES[@]}"; do [[ -n "$l" ]] && echo " * $l" || echo " *"; done; echo " */"
  fi
}

missing=()
while IFS= read -r -d '' f; do
  [[ -f "$f" ]] || continue
  case "$f" in
    *.lock|pnpm-lock.yaml|*/uv.lock|*.min.*|*/fixtures/*|*.generated.*|.github/*) continue ;;
  esac
  st="$(style "$f")"; [[ "$st" == none ]] && continue
  head -n 15 "$f" | grep -qF "$MARK" && continue
  if (( FIX )); then
    tmp="$(mktemp)"
    if head -n 1 "$f" | grep -q '^#!'; then
      { head -n 1 "$f"; header "$st"; tail -n +2 "$f"; } > "$tmp"
    else
      { header "$st"; [[ "$st" == hash ]] && echo; [[ "$st" == block ]] && echo; cat "$f"; } > "$tmp"
    fi
    cat "$tmp" > "$f" && rm -f "$tmp"
    echo "added header: $f"
  else
    missing+=("$f")
  fi
done < <(git ls-files -z --cached --others --exclude-standard)

if (( ${#missing[@]} )); then
  printf 'missing wa-a11y AGPLv3 header: %s\n' "${missing[@]}"
  echo "fix: scripts/license-headers --fix"
  exit 1
fi
(( FIX )) || echo "all source files carry the wa-a11y AGPLv3 header"
