# pursuant to AGPLv3 Section 5 and Section 7.
set -uo pipefail
ROOT="$(git -C "$(dirname "$0")" rev-parse --show-toplevel 2>/dev/null)" || { echo "sr-check: not in a git repo" >&2; exit 2; }
cd "$ROOT" || exit 2

TMP="$(mktemp -d)"
PID=""
cleanup() { [[ -n "$PID" ]] && kill "$PID" 2>/dev/null; wait "$PID" 2>/dev/null; rm -rf "$TMP"; }
trap cleanup EXIT

[[ -f styles/dist/wa-a11y.css && -f styles/dist/fonts/fonts.json ]] || pnpm -C styles build >/dev/null || exit 2

PORT="$(python3 -c 'import socket; s=socket.socket(); s.bind(("127.0.0.1",0)); print(s.getsockname()[1])')"
export WA_A11Y_DB_URL="sqlite:///$TMP/sr-check.db"
export WA_A11Y_SESSION_SECRET="sr-check-only-not-a-secret"
export WA_A11Y_RUNNER=0
export WA_A11Y_CSS="$ROOT/styles/dist/wa-a11y.css"
export WA_A11Y_FONTS="$ROOT/styles/dist/fonts"
unset WA_A11Y_BASE_PATH

(cd web && uv run alembic upgrade head >/dev/null 2>&1 && PYTHONPATH=. uv run python ../selfscan/seed.py) || { echo "sr-check: seeding failed" >&2; exit 2; }
(cd web && exec uv run uvicorn app.main:app --host 127.0.0.1 --port "$PORT" --log-level warning) &
PID=$!
for _ in $(seq 1 60); do curl -s -o /dev/null "http://127.0.0.1:$PORT/healthz" && break; sleep 0.5; done
curl -s -o /dev/null "http://127.0.0.1:$PORT/healthz" || { echo "sr-check: app did not start" >&2; exit 2; }

SELFSCAN_URL="http://127.0.0.1:$PORT" pnpm -C scanner --silent aria