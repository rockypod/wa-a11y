set -euo pipefail
ROOT="$(git rev-parse --show-toplevel)"
HOOK_DIR="$ROOT/.githooks"
HOOK="$HOOK_DIR/pre-push"
mkdir -p "$HOOK_DIR"
git config core.hooksPath .githooks
if [[ -e "$HOOK" ]] && ! grep -q "scripts/check" "$HOOK"; then
  echo "install-hooks: $HOOK exists and is not ours; not overwriting" >&2
  exit 1
fi
chmod +x "$HOOK"
echo "install-hooks: core.hooksPath=$(git config core.hooksPath); pre-push hook ready → $HOOK"
