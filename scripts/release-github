#!/usr/bin/env bash
# wa-a11y
# SPDX-License-Identifier: AGPL-3.0-or-later
#
# This file is part of wa-a11y.
# Copyright (C) 2026 Kevin Miller (rockypod)
# Modifications must retain this wa-a11y notice and document all changes
# pursuant to AGPLv3 Section 5 and Section 7.
# Security: default --dry-run; publishing needs owner sign-off and terminal confirmation
set -uo pipefail

ROOT="$(git -C "$(dirname "$0")" rev-parse --show-toplevel 2>/dev/null)" \
  || { echo "release-github: not inside a git repo" >&2; exit 2; }
cd "$ROOT" || { echo "release-github: cannot cd to repo root" >&2; exit 2; }

MODE=--dry-run
TAG=""
while (($#)); do
  case "$1" in
    --dry-run) MODE=--dry-run ;;
    --publish) MODE=--publish ;;
    -*) echo "usage: scripts/release-github [--dry-run|--publish] TAG" >&2; exit 2 ;;
    *)
      [[ -z "$TAG" ]] || { echo "release-github: only one TAG is allowed" >&2; exit 2; }
      TAG="$1"
      ;;
  esac
  shift
done
[[ -n "$TAG" ]] || { echo "usage: scripts/release-github [--dry-run|--publish] TAG" >&2; exit 2; }

if [[ "$TAG" == -* || "$TAG" == */* || "$TAG" == *..* ]]; then
  echo "release-github: TAG must be a simple tag name" >&2
  exit 2
fi
if [[ "$(git cat-file -t "refs/tags/$TAG" 2>/dev/null || true)" != tag ]]; then
  echo "release-github: annotated tag not found: $TAG" >&2
  exit 1
fi
git rev-parse --verify --quiet "refs/tags/$TAG^{commit}" >/dev/null || {
  echo "release-github: tag does not resolve to a commit: $TAG" >&2
  exit 1
}

if [[ -n "$(git status --porcelain --untracked-files=all)" ]]; then
  echo "release-github: working tree is not clean" >&2
  exit 1
fi

PACK_TAG="${TAG//\//__}"
REVIEW_DIR="$ROOT/releases/review-$PACK_TAG"
SIGNOFF="$REVIEW_DIR/SIGNOFF.md"
REVIEW_ARCHIVE="$REVIEW_DIR/source.tar"
[[ -f "$SIGNOFF" ]] || { echo "release-github: missing owner sign-off: $SIGNOFF" >&2; exit 1; }
[[ -f "$REVIEW_ARCHIVE" ]] || { echo "release-github: missing review archive: $REVIEW_ARCHIVE" >&2; exit 1; }

reviewer="$(sed -n 's/^[[:space:]]*-[[:space:]]*Reviewer:[[:space:]]*//p' "$SIGNOFF" | head -n1)"
review_date="$(sed -n 's/^[[:space:]]*-[[:space:]]*Date[^:]*:[[:space:]]*//p' "$SIGNOFF" | head -n1)"
review_tag="$(sed -n 's/^[[:space:]]*-[[:space:]]*Tag\/ref:[[:space:]]*//p' "$SIGNOFF" | head -n1)"
review_sha="$(sed -n 's/^[[:space:]]*-[[:space:]]*Archive SHA-256:[[:space:]]*//p' "$SIGNOFF" | head -n1 | tr '[:upper:]' '[:lower:]')"
[[ -n "$reviewer" && "$reviewer" != TODO && "$reviewer" != "<reviewer>" ]] || {
  echo "release-github: sign-off reviewer is empty" >&2; exit 1;
}
[[ "$review_date" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]] || {
  echo "release-github: sign-off date is missing or invalid" >&2; exit 1;
}
[[ "$review_tag" == "$TAG" ]] || {
  echo "release-github: sign-off tag does not match: $review_tag" >&2; exit 1;
}
[[ "$review_sha" =~ ^[0-9a-f]{64}$ ]] || {
  echo "release-github: sign-off archive SHA-256 is missing or invalid" >&2; exit 1;
}

TMP="$(mktemp -d)"
trap 'rm -rf "$TMP"' EXIT
ARCHIVE="$TMP/source.tar"
git archive --format=tar "$TAG" >"$ARCHIVE" || {
  echo "release-github: could not archive $TAG" >&2; exit 1;
}
archive_sha="$(sha256sum "$ARCHIVE" | awk '{print tolower($1)}')"
review_archive_sha="$(sha256sum "$REVIEW_ARCHIVE" | awk '{print tolower($1)}')"
if [[ "$archive_sha" != "$review_archive_sha" || "$archive_sha" != "$review_sha" ]]; then
  echo "release-github: sign-off SHA-256 does not match git archive $TAG" >&2
  echo "  expected: $archive_sha" >&2
  echo "  sign-off: $review_sha" >&2
  echo "  review:   $review_archive_sha" >&2
  exit 1
fi

scripts/check || { echo "release-github: scripts/check failed" >&2; exit 1; }
scripts/verify-export "$TAG" || { echo "release-github: verify-export failed" >&2; exit 1; }

OUT="$ROOT/releases/github-$PACK_TAG"
# A previous dry run of the same tag may be replaced; anything else is refused.
if [[ -e "$OUT/.dry-run" ]]; then
  rm -rf "$OUT"
fi
if [[ -e "$OUT" ]]; then
  echo "release-github: output already exists; refusing to overwrite: $OUT" >&2
  exit 1
fi
mkdir -p "$OUT/source"
tar -xf "$ARCHIVE" -C "$OUT/source" || { echo "release-github: could not extract archive" >&2; exit 1; }
gitleaks dir --no-banner --redact "$OUT/source" || {
  echo "release-github: gitleaks found a release-tree finding" >&2; exit 1;
}

LOCAL_REPO="$OUT/repo"
git init -q --initial-branch=main "$LOCAL_REPO" || { echo "release-github: git init failed" >&2; exit 1; }
cp -a "$OUT/source/." "$LOCAL_REPO/"
git -C "$LOCAL_REPO" add -A
git -C "$LOCAL_REPO" -c user.name="wa-a11y release builder" \
  -c user.email="release-builder@localhost" \
  commit -qm "release: wa-a11y $TAG [AGPLv3 Corresponding Source]" || {
  echo "release-github: orphan commit failed" >&2; exit 1;
}
git -C "$LOCAL_REPO" -c user.name="wa-a11y release builder" \
  -c user.email="release-builder@localhost" tag -a "$TAG" -m "wa-a11y $TAG [AGPLv3 Corresponding Source]" || {
  echo "release-github: local release tag failed" >&2; exit 1;
}

echo "release-github: $MODE — tag $TAG"
echo "release-github: owner sign-off by $reviewer on $review_date"
echo "release-github: archive SHA-256 $archive_sha"
echo "release-github: local orphan repository $LOCAL_REPO"
git -C "$LOCAL_REPO" ls-tree -r --name-only HEAD | sed 's/^/  /'

if [[ "$MODE" == --dry-run ]]; then
  : >"$OUT/.dry-run"
  echo "release-github: dry-run complete; nothing was published"
  exit 0
fi

REMOTE="${WA_A11Y_GITHUB_REMOTE:-}"
[[ -n "$REMOTE" ]] || {
  echo "release-github: --publish requires WA_A11Y_GITHUB_REMOTE" >&2; exit 1;
}
[[ -t 0 && -t 1 ]] || {
  echo "release-github: --publish requires an interactive terminal confirmation" >&2; exit 1;
}
read -r -p "Publish $TAG to $REMOTE? [y/N] " answer
case "$answer" in
  y|Y|yes|YES) ;;
  *) echo "release-github: publish cancelled"; exit 1 ;;
esac
RELEASER="wa-a11y release builder"
# The public main holds release commits only: each release is built on the previous one, so
# publishing is a fast-forward (never a force-push). Refuse anything this script did not make.
if git -C "$LOCAL_REPO" ls-remote --exit-code --tags "$REMOTE" "refs/tags/$TAG" >/dev/null 2>&1; then
  echo "release-github: $TAG already exists on $REMOTE; refusing" >&2; exit 1
fi
if git -C "$LOCAL_REPO" ls-remote --exit-code --heads "$REMOTE" main >/dev/null 2>&1; then
  git -C "$LOCAL_REPO" fetch -q "$REMOTE" main || { echo "release-github: fetch failed" >&2; exit 1; }
  if git -C "$LOCAL_REPO" log --format='%an' FETCH_HEAD | grep -vqx "$RELEASER"; then
    echo "release-github: remote main has commits not made by this script; refusing" >&2; exit 1
  fi
  parent="$(git -C "$LOCAL_REPO" rev-parse FETCH_HEAD)"
  commit="$(GIT_AUTHOR_NAME="$RELEASER" GIT_AUTHOR_EMAIL=release-builder@localhost \
    GIT_COMMITTER_NAME="$RELEASER" GIT_COMMITTER_EMAIL=release-builder@localhost \
    git -C "$LOCAL_REPO" commit-tree "HEAD^{tree}" -p "$parent" \
    -m "release: wa-a11y $TAG [AGPLv3 Corresponding Source]")" || {
    echo "release-github: release commit failed" >&2; exit 1;
  }
  git -C "$LOCAL_REPO" reset -q --soft "$commit"
  git -C "$LOCAL_REPO" -c user.name="$RELEASER" -c user.email=release-builder@localhost \
    tag -f -a "$TAG" -m "wa-a11y $TAG [AGPLv3 Corresponding Source]" >/dev/null
fi
# Atomic: the branch and the tag land together or not at all.
git -C "$LOCAL_REPO" push --atomic "$REMOTE" "HEAD:refs/heads/main" "refs/tags/$TAG:refs/tags/$TAG" || {
  echo "release-github: publish failed" >&2; exit 1;
}
echo "release-github: published $TAG"
